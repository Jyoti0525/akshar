# AKSHAR environment. Copy to .env and adjust.
# `docker compose up` supplies its own values; these are for running locally.

# --- database (Postgres 17 + pgvector 0.8) ---------------------------------
AKSHAR_DATABASE_URL=postgresql+psycopg://akshar:akshar@localhost:5432/akshar

# auto | memory | sql. `auto` uses Postgres when a driver is importable and the
# in-memory stores when it is not, so a clean clone runs with no configuration.
# Production refuses to boot on `memory` — see api/sql/engine.py.
AKSHAR_STORAGE=auto

# --- queue (Redis 7, Dramatiq broker) --------------------------------------
AKSHAR_REDIS_URL=redis://localhost:6379/0

# redis | stub. Unset means: Redis, unless pytest is running. Set it explicitly
# in a deployment so the API can never fall through to the in-process stub and
# silently drop the evidence uploads it believes it queued.
AKSHAR_BROKER=redis

# --- object storage (MinIO) ------------------------------------------------
# Images NEVER go in the database. Section 6.
AKSHAR_MINIO_ENDPOINT=localhost:9000
AKSHAR_MINIO_ACCESS_KEY=akshar
AKSHAR_MINIO_SECRET_KEY=akshar-secret
AKSHAR_MINIO_SECURE=false
AKSHAR_EVIDENCE_BUCKET=akshar-evidence
AKSHAR_DERIVED_BUCKET=akshar-derived

# --- auth ------------------------------------------------------------------
AKSHAR_JWT_SECRET=dev-only-change-me
AKSHAR_JWT_ALGORITHM=HS256
AKSHAR_ACCESS_TOKEN_MINUTES=30
AKSHAR_REFRESH_TOKEN_DAYS=14

# --- rules -----------------------------------------------------------------
# Override to run a different rulepack version without redeploying.
AKSHAR_RULEPACK_PATH=rules/packs/lmpc_2011.yaml

# --- privacy (section 18, DPDP Act 2023) -----------------------------------
# Geolocation is stored at reduced precision: enough to identify a market,
# not a doorway. 3 decimal places is roughly 110 m.
AKSHAR_GEO_PRECISION_DP=3
AKSHAR_BLUR_FACES=true

# --- web -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
